{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tomato Current Affairs Feed — SSC + RRB",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "articles"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "articles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "date", "category", "title", "summary", "sourceName", "sourceUrl", "examTags", "editorialReview", "questions"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "date": { "type": "string", "format": "date", "description": "Publication/coverage date for this item." },
          "eventDate": { "type": "string", "format": "date", "description": "Optional event date when different from publication date." },
          "category": { "enum": ["National Affairs", "International Affairs", "Economy", "Science & Technology", "Defence", "Environment", "Sports", "Awards & Appointments"] },
          "title": { "type": "string", "minLength": 5 },
          "summary": { "type": "string", "minLength": 10 },
          "sourceName": { "type": "string", "minLength": 2 },
          "sourceUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
          "examTags": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["SSC", "RRB"] } },
          "editorialReview": {
            "type": "object",
            "required": ["status", "reviewer", "checkedAt"],
            "properties": {
              "status": { "const": "approved" },
              "reviewer": { "type": "string", "minLength": 1 },
              "checkedAt": { "type": "string", "format": "date-time" },
              "crossCheckSources": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["sourceName", "sourceUrl"],
                  "properties": {
                    "sourceName": { "type": "string", "minLength": 1 },
                    "sourceUrl": { "type": "string", "format": "uri", "pattern": "^https://" }
                  }
                }
              },
              "singleSourceJustification": { "type": "string", "minLength": 20 }
            },
            "anyOf": [
              { "required": ["crossCheckSources"], "properties": { "crossCheckSources": { "minItems": 1 } } },
              { "required": ["singleSourceJustification"] }
            ]
          },
          "questions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["question", "options", "answer", "explanation", "reviewed"],
              "properties": {
                "question": { "type": "string", "minLength": 5 },
                "options": { "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
                "answer": { "type": "integer", "minimum": 0, "maximum": 3 },
                "explanation": { "type": "string", "minLength": 8 },
                "reviewed": { "const": true }
              }
            }
          }
        }
      }
    }
  }
}
